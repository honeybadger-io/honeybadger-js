{
  "name": "@honeybadger-io/cloudflare",
  "version": "0.3.9",
  "description": "Cloudflare Workers integration for Honeybadger",
  "keywords": [
    "cloudflare",
    "honeybadger"
  ],
  "files": [
    "./dist"
  ],
  "author": "Pangratios Cosma <pangratios.cosma@honeybadger.io>",
  "homepage": "https://github.com/honeybadger-io/honeybadger-js#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeybadger-io/honeybadger-js.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "jest --config jest.config.cjs",
    "build": "tsc",
    "clean": "rm -rf dist",
    "build:clean": "npm run clean && npm run build"
  },
  "bugs": {
    "url": "https://github.com/honeybadger-io/honeybadger-js/issues"
  },
  "dependencies": {
    "@honeybadger-io/core": "workspace:^",
    "@honeybadger-io/js": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
