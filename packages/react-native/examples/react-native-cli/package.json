{
  "name": "react-native-cli-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "install:clean": "rm -rf node_modules && npm install",
    "android": "react-native run-android",
    "android:release": "rm -rf android/app/build && react-native run-android --mode release",
    "ios": "react-native run-ios",
    "ios:install": "cd ios && pod install && cd ..",
    "ios:release": "react-native run-ios --configuration Release",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@honeybadger-io/react-native": "latest",
    "react": "19.2.8",
    "react-native": "0.87.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.8",
    "typescript": "7.0.2"
  },
  "jest": {
    "preset": "react-native"
  }
}
